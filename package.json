{
  "name": "almasix",
  "displayName": "Almasix",
  "description": "Native Almasix Idea parity via smith ide:index — Prism, completions, navigation, rename, and Smith helpers for VS Code / Cursor / VSCodium",
  "version": "0.4.1",
  "publisher": "almasix",
  "license": "MIT",
  "icon": "media/almasix.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "almasix",
    "prism",
    "laravel",
    "python",
    "smith"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:prism-html",
    "onLanguage:dotenv",
    "workspaceContains:bootstrap/app.py",
    "onView:almasixSymbols",
    "onCommand:almasix.rebuildIndex",
    "onCommand:almasix.newGenerator",
    "onCommand:almasix.newModel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "prism-html",
        "aliases": [
          "Prism",
          "prism-html",
          "Prism HTML"
        ],
        "extensions": [
          ".prism.html"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dotenv",
        "aliases": [
          "DotEnv",
          "dotenv"
        ],
        "filenames": [
          ".env"
        ],
        "filenamePatterns": [
          ".env.*"
        ],
        "configuration": "./dotenv-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "prism-html",
        "scopeName": "text.html.prism",
        "path": "./syntaxes/prism.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python",
          "text.html.basic": "html"
        }
      },
      {
        "language": "dotenv",
        "scopeName": "source.dotenv",
        "path": "./syntaxes/dotenv.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "prism-html",
        "path": "./snippets/prism.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "almasix",
          "title": "Almasix",
          "icon": "media/almasix.svg"
        }
      ]
    },
    "views": {
      "almasix": [
        {
          "id": "almasixSymbols",
          "name": "Symbols"
        }
      ]
    },
    "configuration": {
      "title": "Almasix",
      "properties": {
        "almasix.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter for smith / optional LSP (e.g. ${workspaceFolder}/.venv/bin/python). Empty = try .venv then PATH."
        },
        "almasix.smithPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the smith executable. Empty = .venv/bin/smith, ./smith, or PATH."
        },
        "almasix.useLsp": {
          "type": "boolean",
          "default": false,
          "description": "Start the legacy almasix-lsp client in addition to the native index (default false)."
        },
        "almasix.lsp.command": {
          "type": "string",
          "default": "",
          "description": "Override LSP launch command when almasix.useLsp is true."
        },
        "almasix.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for the language server process."
        }
      }
    },
    "commands": [
      {
        "command": "almasix.rebuildIndex",
        "title": "Almasix: Rebuild Index",
        "icon": "$(refresh)"
      },
      {
        "command": "almasix.showAppInfo",
        "title": "Almasix: Show Application Info"
      },
      {
        "command": "almasix.restart",
        "title": "Almasix: Restart"
      },
      {
        "command": "almasix.restartServer",
        "title": "Almasix: Restart Language Server"
      },
      {
        "command": "almasix.newGenerator",
        "title": "Almasix: New…",
        "icon": "$(add)"
      },
      {
        "command": "almasix.newModel",
        "title": "Almasix: New Model…"
      },
      {
        "command": "almasix.filterSymbols",
        "title": "Almasix: Filter Symbols",
        "icon": "$(filter)"
      },
      {
        "command": "almasix.openSymbol",
        "title": "Almasix: Open Symbol"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "almasix.rebuildIndex",
          "when": "view == almasixSymbols",
          "group": "navigation"
        },
        {
          "command": "almasix.filterSymbols",
          "when": "view == almasixSymbols",
          "group": "navigation"
        },
        {
          "command": "almasix.newGenerator",
          "when": "view == almasixSymbols",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "almasix.newGenerator",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "almasix.openSymbol",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "almasix",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "Smith task name (serve, queue:work, migrate, test)"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "check": "tsc -p ./ --noEmit",
    "compile": "npm run check && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-prism": "node ./scripts/sync-prism.js",
    "prepackage": "npm run sync-prism && npm run compile",
    "package": "npx --yes @vscode/vsce package",
    "vsce": "npm run package",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almasix-dev/almasix-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/almasix-dev/almasix-vscode/issues"
  },
  "homepage": "https://github.com/almasix-dev/almasix-vscode#readme",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
